# JWT Configuration
# SECURITY: Generate a cryptographically random 256-bit (32-byte) secret and base64 encode it
# Example: openssl rand -base64 32
JWT_SECRET=<Base64 32바이트 이상 비밀 키>
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=14

# Cookie Configuration
# SECURITY: Production defaults to secure=true (HTTPS only)
# For local development over HTTP, explicitly override:
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
