POSTGRES_DB=drrk
POSTGRES_USER=drrk
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=drrk_app
RABBITMQ_PASSWORD=change-me-rabbit-password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

CONGESTION_CONSUMER_AUTO_STARTUP=true
INFERENCE_CONSUMER_AUTO_STARTUP=true

JWT_SECRET=change-me-at-least-32-bytes-long-for-local
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:5173

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=test@example.com
SMTP_PASSWORD=change-me-smtp-password

AIRPORT_COLLECTION_ENABLED=true
AIRPORT_COLLECTION_FIXED_DELAY=PT5M
AIRPORT_COLLECTION_INITIAL_DELAY=PT1S
AIRPORT_API_NUM_OF_ROWS=1000
AIRPORT_ARRIVAL_STATUS_API_URL=https://airport.example/arrival
AIRPORT_ARRIVAL_STATUS_API_KEY=change-me-arrival-key
AIRPORT_PASSENGER_FORECAST_API_URL=https://airport.example/passenger
AIRPORT_PASSENGER_FORECAST_API_KEY=change-me-passenger-key
AIRPORT_RAILROAD_API_URL=https://airport.example/railroad
AIRPORT_RAILROAD_API_KEY=change-me-railroad-key
AIRPORT_RAILROAD_TRAIN_CLASS=
AIRPORT_RAILROAD_STATION_CODE=

CONGESTION_CALCULATION_ENABLED=true
CONGESTION_CALCULATION_FIXED_RATE=PT10S
CONGESTION_CALCULATION_INITIAL_DELAY=PT10S
CONGESTION_API_MAX_AGE=PT10M
CONGESTION_MODEL_MAX_AGE=PT10S
CONGESTION_MOVING_WALKWAY_ENABLED=true
CONGESTION_SENSOR_SPACE_ID=sensor-space-example
CONGESTION_PUBLISH_CONFIRM_TIMEOUT=PT2S
