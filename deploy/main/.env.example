INFERENCE_CONSUMER_AUTO_STARTUP=true
INFERENCE_STREAM_FIXED_RATE=PT5S
INFERENCE_STREAM_SNAPSHOT_MAX_AGE=PT5S
INFERENCE_STREAM_CONGESTION_MAX_AGE=PT25S
INFERENCE_STREAM_EMITTER_TIMEOUT=PT30M

